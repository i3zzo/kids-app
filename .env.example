# Kids app settings. Copy to .env and fill in.

PORT=3000

# Where the app reaches OmniRoute. docker-compose overrides this to http://omniroute:20128/v1.
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Create this in the OmniRoute dashboard: Endpoints / API Keys. Keep it secret.
OMNIROUTE_API_KEY=

# Pin a specific model from a provider you trust, e.g. "openai/gpt-4o-mini".
# "auto" lets OmniRoute choose among any providers you've connected.
OMNIROUTE_MODEL=auto

OMNIROUTE_MAX_TOKENS=400
OMNIROUTE_TIMEOUT_MS=30000

# Max AI requests per device per minute.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
