# Copy this file to .env (git ignores it) and fill in your Supabase values.
#
# EXPO_PUBLIC_* values are bundled into the app, so ONLY put values here that
# are safe for anyone to see:
#   - the project URL
#   - the "anon" / publishable key (it is public by design; Row Level Security
#     in the database decides what each signed-in parent can see)
#
# NEVER put the service_role / secret key, database password, JWT secret or SMS
# provider token in this app. Those stay on the server only.
#
# Local development: run `npx supabase start` in the repo root, then
# `npx supabase status` prints the URL and the anon key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-here
