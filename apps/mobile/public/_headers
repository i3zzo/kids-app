# Netlify / Cloudflare Pages cache rules.
# Files under these folders have a content hash in their name, so a new build
# gets new names: safe to cache for a year.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The page itself must always be checked, so testers get each new build at once.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
