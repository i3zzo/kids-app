# OmniRoute gateway secrets. Copy to omniroute.env and fill in BEFORE the first start.
# Generate random values with:  openssl rand -hex 32
# Full list of options: https://github.com/cheaper-inference/OmniRoute/blob/main/.env.example

JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=

# Dashboard login password. Change it.
INITIAL_PASSWORD=CHANGEME
