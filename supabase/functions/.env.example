# Server-only secrets for the Edge Functions. Copy to supabase/functions/.env
# for local development (git-ignored). In production set them with:
#   supabase secrets set --env-file supabase/functions/.env
# Never put these in the app.
OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTE_API_KEY=
# Pin a model from a provider that does not train on API data, e.g. "openai/gpt-4o-mini".
OMNIROUTE_MODEL=auto
OMNIROUTE_TIMEOUT_MS=30000
