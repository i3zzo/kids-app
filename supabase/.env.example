# Copy this file to supabase/.env (which git ignores) before `npx supabase start`.
# For LOCAL development these placeholder values are fine: the test phone numbers
# in config.toml (+965 5000 0001 … 0003, code 123456) never send a real SMS.
# For a real server, replace them with your SMS provider's values and keep them
# out of git.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=local-placeholder
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=local-placeholder
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=local-placeholder
